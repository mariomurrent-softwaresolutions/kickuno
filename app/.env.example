# Copy to .env for local development.
# The Payload backend's base URL — from a physical device or simulator,
# "localhost" only works if the CMS is on the same machine reachable that
# way (iOS simulator: yes; Android emulator/physical device: use your Mac's
# LAN IP instead, e.g. http://192.168.1.23:3000).
EXPO_PUBLIC_API_URL=http://localhost:3000
